# Do not put real secrets in this file.

# Production env vars.
GITHUB_OWNER=kohei321dev
DATABASE_URL=
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
OWNER_AI_KEY=
OWNER_AI_MODEL=grok-4.3
OWNER_AI_EFFORT=medium
SAKANA_API_KEY=
SAKANA_AI_MODEL=fugu
SAKANA_AI_EFFORT=high
VIEWER_AI_KEY=
VIEWER_AI_MODEL=claude-haiku-4-5-20251001

# Server-side xAI speech generation reuses OWNER_AI_KEY. Keep all keys out of the browser.
SAYDECK_TTS_VOICE=eve
SAYDECK_TTS_SPEED=1.0

# Required for private audio/APKG storage in Vercel Production.
BLOB_READ_WRITE_TOKEN=

# Owner-only Slack capture. Use the immutable Slack member ID, not a display name.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_OWNER_USER_ID=
SLACK_OWNER_TEAM_ID=

# Owner-only Discord capture. Use the immutable Discord user ID.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_OWNER_USER_ID=
DISCORD_OWNER_GUILD_ID=
# Optional: register /saydeck immediately in one test server. Omit for global registration.
DISCORD_COMMAND_GUILD_ID=

# AI guardrails:
# - OWNER_AI_MODEL only allows grok-4.3.
# - VIEWER_AI_MODEL only allows claude-haiku-4-5-20251001.
# - OWNER_AI_EFFORT allows low, medium, or high and defaults to medium.

# GitHub OAuth callback URL:
#   https://your-vercel-url/api/auth/callback/github

# Local UI verification only. This is ignored when NODE_ENV=production.
DEV_AUTH_BYPASS=1
